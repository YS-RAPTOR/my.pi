{
  "name": "@ys-raptor/orogeny.pi",
  "private": true,
  "type": "module",
  "imports": {
    "#o/*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "spike": "node --experimental-strip-types src/spike.ts && node --experimental-strip-types src/output-spike.ts && node --experimental-strip-types src/notebook-spike.ts && node --experimental-strip-types src/notebook-wait-spike.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102",
    "mime-types": "3.0.2",
    "zeromq": "6.5.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@types/mime-types": "3.0.1"
  }
}
