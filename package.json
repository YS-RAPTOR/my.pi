{
  "name": "@ys-raptor/my.pi",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "extensions/stratum"
  ],
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('node_modules', { force: true, recursive: true })\"",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings extensions",
    "lint:fix": "oxlint --fix extensions",
    "effect:patch": "effect-tsgo patch"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@effect/tsgo": "0.24.3",
    "@types/node": "26.1.2",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
